{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoundTube",
  "version": "1.3.2",
  "identifier": "app.melodown.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Local music playlist archiver",
    "longDescription": "SoundTube saves YouTube Music and SoundCloud playlists into a tagged local music library.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": ["ffmpeg"]
      }
    },
    "externalBin": ["binaries/melodown-server"]
  }
}
