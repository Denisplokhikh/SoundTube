# Скопируйте в .env и поправьте под себя.
# Все переменные необязательны.

# Куда складывать музыку (по умолчанию ~/Music/Melodown)
# MELODOWN_MUSIC_DIR=C:\Users\you\Music\Melodown

# Где хранить базу и временные файлы (по умолчанию ./data)
# MELODOWN_DATA_DIR=./data

# original | mp3 | m4a | opus | flac
MELODOWN_AUDIO_FORMAT=original
MELODOWN_AUDIO_QUALITY=0

# Сколько плейлистов обрабатывать одновременно и сколько треков внутри одного
MELODOWN_MAX_CONCURRENT_JOBS=1
MELODOWN_MAX_CONCURRENT_TRACKS=1
MELODOWN_RETRIES=3

# Максимум треков из одного плейлиста (защита от бесконечных радио-миксов)
MELODOWN_LIMIT_TRACKS=500

# Необязательные cookies.txt для закрытого/возрастного контента
# MELODOWN_YOUTUBE_COOKIES=./cookies/youtube.txt
# MELODOWN_SOUNDCLOUD_COOKIES=./cookies/soundcloud.txt

# Прокси для скачивания, если нужен
# MELODOWN_PROXY=http://127.0.0.1:1080

# Адрес веб-интерфейса
MELODOWN_HOST=127.0.0.1
MELODOWN_PORT=8765
